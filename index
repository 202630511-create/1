<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>오늘 저녁 뭐 먹지? | 저녁 메뉴 추천</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Gmarket+Sans:wght@500;700&family=Noto+Sans+KR:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #FF6B6B;
            --primary-hover: #FF5252;
            --secondary: #4ECDC4;
            --accent: #FFE66D;
            --bg-color: #FFF9F5;
            --card-bg: #FFFFFF;
            --text-main: #2D3436;
            --text-sub: #636E72;
            --shadow: 0 12px 30px rgba(255, 107, 107, 0.15);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Noto Sans KR', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
            background-image: radial-gradient(#FFD8D8 1px, transparent 1px);
            background-size: 24px 24px;
        }

        .container {
            background-color: var(--card-bg);
            padding: 40px 30px;
            border-radius: 28px;
            box-shadow: var(--shadow);
            text-align: center;
            max-width: 440px;
            width: 100%;
            border: 2px solid #FFE3E3;
            position: relative;
            overflow: hidden;
        }

        .header {
            margin-bottom: 25px;
        }

        .badge {
            display: inline-block;
            background-color: #FFEAE8;
            color: var(--primary);
            font-size: 0.85rem;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 20px;
            margin-bottom: 12px;
        }

        h1 {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        p.subtitle {
            font-size: 0.95rem;
            color: var(--text-sub);
            line-height: 1.4;
        }

        .display-card {
            background-color: #FFF5F3;
            border: 2px dashed #FFD1C1;
            border-radius: 20px;
            padding: 30px 20px;
            margin: 25px 0;
            min-height: 200px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: all 0.3s ease;
        }

        .emoji-box {
            font-size: 5rem;
            line-height: 1.2;
            margin-bottom: 12px;
            filter: drop-shadow(0 8px 10px rgba(0,0,0,0.1));
            user-select: none;
        }

        .food-name {
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 6px;
            word-break: keep-all;
        }

        .food-category {
            font-size: 0.85rem;
            color: #FF8E8E;
            font-weight: 600;
            background-color: #FFFFFF;
            padding: 4px 12px;
            border-radius: 12px;
            border: 1px solid #FFD1C1;
        }

        .btn-recommend {
            background-color: var(--primary);
            color: white;
            font-size: 1.15rem;
            font-weight: 700;
            border: none;
            padding: 16px 32px;
            border-radius: 50px;
            cursor: pointer;
            width: 100%;
            box-shadow: 0 8px 20px rgba(255, 107, 107, 0.35);
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            outline: none;
        }

        .btn-recommend:hover {
            background-color: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(255, 107, 107, 0.45);
        }

        .btn-recommend:active {
            transform: translateY(1px);
            box-shadow: 0 4px 12px rgba(255, 107, 107, 0.25);
        }

        /* Animation classes */
        .rolling {
            animation: bounceScale 0.15s infinite alternate;
        }

        @keyframes bounceScale {
            0% { transform: scale(0.92); }
            100% { transform: scale(1.08); }
        }

        .pop-in {
            animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        @keyframes popIn {
            0% { opacity: 0; transform: scale(0.5); }
            100% { opacity: 1; transform: scale(1); }
        }

        footer {
            margin-top: 20px;
            font-size: 0.8rem;
            color: #A0AEC0;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="header">
            <span class="badge">오늘의 메뉴 결정장애 해결사</span>
            <h1>저녁 메뉴 추천 🍽️</h1>
            <p class="subtitle">버튼을 누르면 맛있는 저녁 메뉴가<br>귀여운 이모지와 함께 나와요!</p>
        </div>

        <div class="display-card" id="displayCard">
            <div class="emoji-box" id="emoji">❓</div>
            <div class="food-name" id="foodName">무엇을 먹을까요?</div>
            <div class="food-category" id="foodCategory">버튼을 눌러주세요</div>
        </div>

        <button class="btn-recommend" id="recommendBtn" onclick="getRecommendation()">
            🎲 저녁 메뉴 추천받기
        </button>
    </div>

    <footer>© 오늘 저녁 메뉴 추천 | Delicious Dinner Picker</footer>

    <script>
        const menuList = [
            { name: "삼겹살", emoji: "🥓", category: "한식" },
            { name: "치킨", emoji: "🍗", category: "야식 / 치맥" },
            { name: "피자", emoji: "🍕", category: "양식" },
            { name: "짜장면 & 탕수육", emoji: "🍜", category: "중식" },
            { name: "초밥", emoji: "🍣", category: "일식" },
            { name: "떡볶이", emoji: "🍢", category: "분식" },
            { name: "햄버거", emoji: "🍔", category: "패스트푸드" },
            { name: "스테이크", emoji: "🥩", category: "양식" },
            { name: "부대찌개", emoji: "🥘", category: "한식" },
            { name: "돈까스", emoji: "🍱", category: "일식/경양식" },
            { name: "파스타", emoji: "🍝", category: "양식" },
            { name: "족발 & 보쌈", emoji: "🍖", category: "한식" },
            { name: "마라탕", emoji: "🍲", category: "중식" },
            { name: "쌀국수", emoji: "🍜", category: "아시안" },
            { name: "타코", emoji: "🌮", category: "멕시칸" },
            { name: "카레", emoji: "🍛", category: "일식/인도" },
            { name: "국밥", emoji: "🥣", category: "한식" },
            { name: "샌드위치 / 샐러드", emoji: "🥗", category: "가벼운 식사" },
            { name: "곱창 / 막창", emoji: "🥢", category: "한식" },
            { name: "회 / 해산물", emoji: "🐟", category: "일식/한식" }
        ];

        let isSpinning = false;

        function getRecommendation() {
            if (isSpinning) return;
            isSpinning = true;

            const emojiEl = document.getElementById('emoji');
            const foodNameEl = document.getElementById('foodName');
            const foodCategoryEl = document.getElementById('foodCategory');
            const displayCard = document.getElementById('displayCard');
            const btn = document.getElementById('recommendBtn');

            btn.disabled = true;
            btn.style.opacity = "0.7";

            // 애니메이션 효과 시작 (슬롯머신처럼 빠르게 전환)
            displayCard.classList.remove('pop-in');
            emojiEl.classList.add('rolling');

            let counter = 0;
            const speed = 70; // 전환 속도 (ms)
            const duration = 1200; // 총 애니메이션 시간 (ms)

            const interval = setInterval(() => {
                const randomTemp = menuList[Math.floor(Math.random() * menuList.length)];
                emojiEl.textContent = randomTemp.emoji;
                foodNameEl.textContent = randomTemp.name;
                foodCategoryEl.textContent = randomTemp.category;
                counter += speed;

                if (counter >= duration) {
                    clearInterval(interval);

                    // 최종 결과 선정
                    const finalSelection = menuList[Math.floor(Math.random() * menuList.length)];
                    
                    emojiEl.textContent = finalSelection.emoji;
                    foodNameEl.textContent = finalSelection.name;
                    foodCategoryEl.textContent = finalSelection.category;

                    // 애니메이션 클래스 교체
                    emojiEl.classList.remove('rolling');
                    displayCard.classList.add('pop-in');

                    // 버튼 원복
                    btn.disabled = false;
                    btn.style.opacity = "1";
                    isSpinning = false;
                }
            }, speed);
        }
    </script>
</body>
</html>
